# === Base de datos (Postgres) ===
# Crea una base de datos Postgres gratuita en https://neon.tech o usa Vercel Postgres/Supabase.
# Copia aquí la cadena de conexión que te den (debe incluir ?sslmode=require en producción).
DATABASE_URL="postgresql://usuario:password@host:5432/basededatos?sslmode=require"

# === Auth.js (NextAuth v5) ===
# Genera un valor aleatorio con: npx auth secret
AUTH_SECRET="reemplaza-esto-con-un-valor-aleatorio-largo"

# Credenciales de OAuth de Google (https://console.cloud.google.com/apis/credentials)
# Redirect URI autorizado: https://TU-DOMINIO/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Credenciales de OAuth de Facebook (https://developers.facebook.com/apps)
# Redirect URI autorizado: https://TU-DOMINIO/api/auth/callback/facebook
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""

# === Administrador ===
# Lista de correos (separados por coma) que se vuelven ADMIN automáticamente al iniciar sesión.
ADMIN_EMAILS="tu-correo@gmail.com"

# === Subida de imágenes (Vercel Blob) ===
# Opcional pero recomendado para producción: https://vercel.com/docs/storage/vercel-blob
# Sin esto, las publicaciones/productos se guardan sin foto.
BLOB_READ_WRITE_TOKEN=""
